# Supabase Configuration
# Copy this file to .env (without the .example)
# Replace the placeholder values below with the ACTUAL credentials
# All team members should use the SAME API key and URL from the shared Supabase project
# Ask your team lead for the real credentials - DO NOT share them in git or chat

EXPO_PUBLIC_SUPABASE_URL=your-supabase-url-here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
